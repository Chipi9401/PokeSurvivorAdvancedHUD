// ==UserScript==
// @name         PokéSurvivor – Zoom FOV + Stats
// @namespace    chipi
// @version      0.12.0
// @description  Rueda del ratón = más/menos campo de visión (personaje centrado). Panel de stats a la derecha y minimapa de aliados.
// @match        https://pokesurvivor.com/*
// @match        https://jpter78.github.io/pokesurvivor/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  'use strict';

  const ZMIN = 0.7, ZMAX = 3;                       // FOV: 1 = normal, 2 = ves el doble
  const clamp = v => Math.min(ZMAX, Math.max(ZMIN, v));
  let Z = clamp(parseFloat(localStorage.getItem('ps_zoom')) || 1);

  /* G puede ser un `const` (no cuelga de window) y eval puede estar bloqueado por CSP,
     así que se captura en el instante en que camera.js hace `G.Camera = {...}`. */
  let G = window.G, Cam = null, last = null;
  const gl = () => G || window.G;

  function applyZoom() {
    if (Cam && last) Cam.resize(...last);           // el wrapper de abajo aplica Z
    localStorage.setItem('ps_zoom', Z.toFixed(3));
  }

  function install(C) {
    if (C._psHooked) return;
    C._psHooked = true; Cam = C;
    const baseW = C.VIEW_W, baseH = C.MIN_VIEW_H, orig = C.resize;
    C.resize = function (w, h, d) {
      last = [w, h, d];
      this.VIEW_W = baseW * Z;
      this.MIN_VIEW_H = baseH * Z;
      return orig.call(this, w, h, d);
    };
    if (C.w) { last = [C.w * C.scale, C.h * C.scale, C.dpr]; applyZoom(); }
  }

  if (G && G.Camera) install(G.Camera);
  else Object.defineProperty(Object.prototype, 'Camera', {
    configurable: true,
    get() { return undefined; },
    set(v) {
      Object.defineProperty(this, 'Camera', { value: v, writable: true, enumerable: true, configurable: true });
      if (v && typeof v.resize === 'function' && typeof v.VIEW_W === 'number') {
        delete Object.prototype.Camera;             // ya lo tenemos: quitar el anzuelo
        G = this; install(v);
      }
    }
  });


  /* La clase G.Player se envuelve con un Proxy para capturar cada instancia creada
     (el jugador local es la última que no sea compañero remoto). */
  const instances = [];
  const isPlayerClass = v => typeof v === 'function' && v.prototype &&
    typeof v.prototype.hurt === 'function' && typeof v.prototype.gainXp === 'function';
  function patchPlayer(v) {                         // reloj propio: solo avanza cuando el juego actualiza al jugador
    const orig = v.prototype.update;
    v.prototype.update = function (dt) {
      this._psTime = (this._psTime || 0) + dt;
      this._psUpd = performance.now();
      return orig.call(this, dt);
    };
  }
  const wrapPlayer = v => new Proxy(v, {
    construct(t, a, nt) {
      const o = Reflect.construct(t, a, nt);
      instances.push(o); if (instances.length > 12) instances.shift();
      return o;
    }
  });
  if (G && G.Player && isPlayerClass(G.Player)) { patchPlayer(G.Player); G.Player = wrapPlayer(G.Player); }
  else Object.defineProperty(Object.prototype, 'Player', {
    configurable: true,
    get() { return undefined; },
    set(v) {
      const ok = isPlayerClass(v);
      if (ok) patchPlayer(v);
      Object.defineProperty(this, 'Player', { value: ok ? wrapPlayer(v) : v, writable: true, enumerable: true, configurable: true });
      if (ok) delete Object.prototype.Player;
    }
  });

  /* G.Hazards.add(...) se envuelve para saber dónde caen zonas y rayos y poder resaltarlos. */
  const hazards = [];
  const isHazards = v => v && typeof v === 'object' && typeof v.add === 'function';
  function wrapHazards(H) {
    if (H._psW) return; H._psW = true;
    const orig = H.add;
    H.add = function (h) {
      try { const lp = currentPlayer(); hazards.push({ ...h, t0: lp ? lp._psTime || 0 : 0 }); if (hazards.length > 200) hazards.shift(); } catch {}
      return orig.apply(this, arguments);
    };
  }
  if (G && isHazards(G.Hazards)) wrapHazards(G.Hazards);
  else Object.defineProperty(Object.prototype, 'Hazards', {
    configurable: true,
    get() { return undefined; },
    set(v) {
      Object.defineProperty(this, 'Hazards', { value: v, writable: true, enumerable: true, configurable: true });
      if (isHazards(v)) { delete Object.prototype.Hazards; wrapHazards(v); }
    }
  });

  /* ---------- BARRA DE VIDA DE ENEMIGOS ----------
     Enemy.draw pinta su barra con dos fillRect de 3,4 px de alto. Mientras dibuja un
     enemigo, esos dos rectángulos se agrandan (centrados en el enemigo). */
  const HPBAR = { normal: [1, 1], big: [1.5, 2.3], huge: [2, 3.4] };   // [ancho, alto]
  let curEnemy = null;
  const nativeFill = CanvasRenderingContext2D.prototype.fillRect;
  CanvasRenderingContext2D.prototype.fillRect = function (x, y, w, h) {
    if (curEnemy !== null && h === 3.4) {
      const [kw, kh] = HPBAR[cfg.hpbar] || HPBAR.normal;
      if (kw !== 1 || kh !== 1) {
        const e = curEnemy, w0 = e.boss ? 90 : Math.max(22, e.r * 2);
        const nh = h * kh, nw = w * kw, nx = e.x - (w0 * kw) / 2, ny = y - (nh - h) / 2;
        if (/^rgba\(0, 0, 0/.test(this.fillStyle)) {               // fondo: borde oscuro + pista gris
          const f = this.fillStyle;
          this.fillStyle = 'rgba(0,0,0,.9)'; nativeFill.call(this, nx - 1, ny - 1, nw + 2, nh + 2);
          this.fillStyle = '#2b2d3a';        nativeFill.call(this, nx, ny, nw, nh);
          this.fillStyle = f;
          return;
        }
        return nativeFill.call(this, nx, ny, nw, nh);              // relleno de vida
      }
    }
    return nativeFill.apply(this, arguments);
  };
  const isEnemyClass = v => typeof v === 'function' && v.prototype &&
    typeof v.prototype.draw === 'function' && typeof v.prototype.bossMove === 'function';
  function patchEnemy(v) {
    const orig = v.prototype.draw;
    v.prototype.draw = function (ctx) {
      curEnemy = this;
      try { return orig.call(this, ctx); } finally { curEnemy = null; }
    };
  }
  if (G && G.Enemy && isEnemyClass(G.Enemy)) patchEnemy(G.Enemy);
  else Object.defineProperty(Object.prototype, 'Enemy', {
    configurable: true,
    get() { return undefined; },
    set(v) {
      Object.defineProperty(this, 'Enemy', { value: v, writable: true, enumerable: true, configurable: true });
      if (isEnemyClass(v)) { delete Object.prototype.Enemy; patchEnemy(v); }
    }
  });

  function inScrollable(el) {
    if (!(el instanceof Element)) return false;
    for (; el && el !== document.body; el = el.parentElement) {
      const s = getComputedStyle(el);
      if (/(auto|scroll)/.test(s.overflowY) && el.scrollHeight > el.clientHeight) return true;
    }
    return false;
  }

  let lastCycle = 0;
  addEventListener('wheel', e => {
    if (e.composedPath().includes(host) || inScrollable(e.target)) return;  // menú propio y listas del juego
    if (e.shiftKey && cfg.shiftWheel) {              // Mayús + rueda: ciclar ataque
      e.preventDefault();
      const d = e.deltaY || e.deltaX, now = performance.now();
      if (d && now - lastCycle > 120 && isPlayer(player) && !player.dead && player.cycle) { lastCycle = now; player.cycle(d > 0 ? 1 : -1); }
      return;
    }
    e.preventDefault();
    Z = clamp(Z * (e.deltaY > 0 ? 1.1 : 1 / 1.1));  // rueda abajo = ver más
    applyZoom();
  }, { passive: false });

  addEventListener('keydown', e => {
    if (e.key === 'Home') { Z = 1; applyZoom(); }   // Inicio = reset
    if (e.key === 'F8') { cfg.panel = !cfg.panel; save(); render(); }
  });

  /* ---------- ESTADÍSTICAS (campos reales de player.js) ---------- */
  const esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const fmt = v => typeof v === 'number'
    ? (Number.isFinite(v) ? (Number.isInteger(v) ? v : Math.round(v * 100) / 100).toLocaleString('es-ES') : '—')
    : esc(v);
  const pct = v => `${Math.round((v || 0) * 100)}%`;
  const mv = p => { try { return p.activeMove(); } catch { return null; } };

  const metrics = { dps: 0 };
  const fmtT = t => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;
  const moveName = m => ((gl()?.Moves?.BY_ID?.[m.id]?.name) || m.id || '?');

  /** Mejor hueco de ataque contra el enemigo al que apuntas (media de multiplicadores de tipo del grupo). */
  function bestSlot(p) {
    const G = gl(), t = p.target;
    if (!G?.Types || !t || t.dead || !t.types || !p.slots || !p.slots.length) return null;
    let best = -1, bm = -1, cur = 1;
    p.slots.forEach((g, i) => {
      let sum = 0; for (const m of g) sum += G.Types.mult(m.type, t.types);
      const v = sum / (g.length || 1);
      if (i === p.active) cur = v;
      if (v > bm + 1e-9) { bm = v; best = i; }
    });
    return { best, bm, cur };
  }

  // reco: 1 = visible en el preset "Recomendado"
  const STATS = [
    { k: 'level',      label: 'Nivel',               reco: 1, get: p => p.level },
    { k: 'atk',        label: 'Ataque',              reco: 1, get: p => p.atk },
    { k: 'spd',        label: 'Velocidad',           reco: 1, get: p => p.spd },
    { k: 'reduction',  label: 'Reducción de daño',   reco: 1, get: p => pct(p.reduction) },
    { k: 'regen',      label: 'Regeneración',        reco: 1, get: p => `${fmt(p.regen)}/s` },
    { k: 'critChance', label: 'Prob. crítico',       reco: 1, get: p => pct(p.critChance) },
    { k: 'cd',         label: 'Recarga del ataque',  reco: 1, get: p => { const m = mv(p); return m ? `${fmt(m.cd * p.cdMul)} s` : '—'; } },
    { k: 'move',       label: 'Ataque activo',       reco: 1, get: p => { const m = mv(p); return m ? `${(gl()?.Moves?.BY_ID?.[m.id]?.name) || m.id} Nv${m.lvl}` : '—'; } },
    { k: 'kills',      label: 'Derrotas',            reco: 1, get: p => p.kills },
    { k: 'coins',      label: 'Monedas',             reco: 1, get: p => p.coins },
    { k: 'time',       label: 'Tiempo de run',       reco: 1, get: p => fmtT(p._psTime || 0) },
    { k: 'dps',        label: 'DPS (últimos 5 s)',   reco: 1, get: p => Math.round(metrics.dps) },
    { k: 'kpm',        label: 'Derrotas por minuto', get: p => (p._psTime > 10 ? (p.kills / (p._psTime / 60)) : 0) },
    { k: 'suggest',    label: 'Mejor ataque ahora',  reco: 1, get: p => {
        const b = bestSlot(p); if (!b) return '—';
        const g = p.slots[b.best], nm = moveName(g[0]).slice(0, 12);
        return b.best === p.active ? `${b.best + 1}·${nm} ×${fmt(b.bm)} ✓` : `${b.best + 1}·${nm} ×${fmt(b.bm)} (ahora ×${fmt(b.cur)})`;
      } },
    { k: 'magnet',     label: 'Imán',                get: p => `${fmt(p.magnet)} px` },
    { k: 'xpMul',      label: 'Bonus de XP',         get: p => `×${fmt(p.xpMul)}` },
    { k: 'coinMul',    label: 'Bonus de monedas',    get: p => `×${fmt(p.coinMul)}` },
    { k: 'bosses',     label: 'Jefes derrotados',    get: p => p.bosses },
    { k: 'dmgDealt',   label: 'Daño infligido',      get: p => p.dmgDealt },
    { k: 'tickets',    label: 'Tickets ×1 / ×10',    get: p => `${p.t1} / ${p.t10}` },
    { k: 'bonds',      label: 'Vínculos',            get: p => p.bonds },
    { k: 'item',       label: 'Objeto',              get: p => p.item ? ((gl()?.Items?.BY?.[p.item]?.name) || p.item) : '—' }
  ];
  const nonReco = () => Object.fromEntries(STATS.filter(s => !s.reco).map(s => [s.k, 1]));

  /* ---------- CONFIG ---------- */
  const DEF = { panel: true, fps: true, fov: true, hp: true, xp: true, hpbar: 'big', tab: 'panel', pos: null, hidden: nonReco(),
    ring: true, support: true, bossHp: true, haz: true, magnet: false, arrows: true, poi: true,
    pauseBlur: true, shiftWheel: true, alerts: true, title: true, autoMove: false,
    mini: true, miniSize: 'medium', miniRange: 'mid', miniPos: null };
  let cfg;
  try { cfg = { ...DEF, ...JSON.parse(localStorage.getItem('ps_cfg3') || '{}') }; } catch { cfg = { ...DEF }; }
  const save = () => localStorage.setItem('ps_cfg3', JSON.stringify(cfg));

  /* ---------- JUGADOR LOCAL ---------- */
  const isPlayer = o => o && typeof o === 'object' && typeof o.hp === 'number' && typeof o.maxHp === 'number' &&
    typeof o.x === 'number' && typeof o.y === 'number' && typeof o.gainXp === 'function';
  function findPlayer() {
    for (let i = instances.length - 1; i >= 0; i--) {
      const p = instances[i];
      if (!p.remote && !p.net) return p;                   // los compañeros de coop llevan net/remote
    }
    return null;
  }
  /** El jugador de la partida en curso: el propio juego lo expone en G.Game.player (null en los menús).
      Si G.Game aún no existe, se usa la última instancia capturada. */
  function currentPlayer() {
    const gm = gl()?.Game;
    return gm ? (gm.player || null) : findPlayer();
  }

  /* ---------- UI (Shadow DOM: no choca con el CSS del juego) ---------- */
  const host = document.createElement('div');
  host.id = 'ps-host';
  host.style.cssText = 'position:fixed;inset:0;z-index:99999;pointer-events:none';
  const root = host.attachShadow({ mode: 'open' });
  root.innerHTML = `
  <style>
    *{box-sizing:border-box}
    :host{font-family:'Pixelify Sans',ui-monospace,Consolas,monospace;font-size:13px;color:#e8eefc}
    .panel,.menu,.mini{background:rgba(10,20,48,.82);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.14);
      border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.45)}
    .panel{position:absolute;right:10px;top:50%;transform:translateY(-50%);min-width:190px;max-width:260px;
      max-height:80vh;overflow:hidden;padding:8px 10px 10px}
    .title{pointer-events:auto;cursor:grab;touch-action:none;user-select:none;display:flex;align-items:center;gap:6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;
      color:#8fb3ff;padding-bottom:6px;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,.1)}
    .title.drag{cursor:grabbing}
    .title small{margin-left:auto;opacity:.5;font-size:10px;letter-spacing:0}
    .title i{width:7px;height:7px;border-radius:50%;background:#46d37a;box-shadow:0 0 6px #46d37a}
    .row{display:flex;justify-content:space-between;gap:14px;padding:2px 0}
    .row span{color:#9fb0d4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .row b{font-weight:600;color:#fff;font-variant-numeric:tabular-nums}
    .good{color:#6ee79a!important}.warn{color:#ffd166!important}.bad{color:#ff6b6b!important}
    .bar{margin:4px 0 6px}
    .bar .lbl{display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px}
    .bar .lbl span{color:#9fb0d4}.bar .lbl b{color:#fff;font-variant-numeric:tabular-nums}
    .track{height:9px;border-radius:5px;background:rgba(255,255,255,.12);overflow:hidden}
    .fill{height:100%;border-radius:5px;transition:width .2s}
    .sep{height:1px;background:rgba(255,255,255,.1);margin:5px 0}
    .empty{color:#7d8db3;font-style:italic;padding:2px 0}
    .btn{position:absolute;right:10px;bottom:10px;width:34px;height:34px;border-radius:50%;cursor:pointer;
      pointer-events:auto;display:grid;place-items:center;font-size:17px;color:#cfe0ff;
      background:rgba(10,20,48,.82);border:1px solid rgba(255,255,255,.2);user-select:none}
    .btn:hover{background:rgba(40,70,140,.9)}
    .menu{position:absolute;right:10px;bottom:52px;width:272px;max-height:72vh;overflow:hidden;padding:0;
      pointer-events:auto;display:none;flex-direction:column}
    .menu.open{display:flex}
    .tabs{display:flex;flex:none;border-bottom:1px solid rgba(255,255,255,.12)}
    .tabs button{flex:1;padding:9px 2px 8px;background:none;border:0;border-bottom:2px solid transparent;color:#9fb0d4;
      font:inherit;font-size:12px;cursor:pointer}
    .tabs button:hover{color:#fff;background:rgba(255,255,255,.06)}
    .tabs button.on{color:#fff;border-bottom-color:#4d8dff}
    .pane{display:none;overflow:auto;padding:10px;flex:1 1 auto;min-height:0}
    .pane.on{display:block}
    .foot{flex:none;padding:8px 10px 9px;border-top:1px solid rgba(255,255,255,.12)}
    .foot .acts{margin-top:0}
    .foot .rec{width:auto;flex:1.7;margin:0}
    .foot .hint{margin-top:6px}
    .menu h4{margin:8px 0 4px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8fb3ff;font-weight:600}
    .menu h4:first-child{margin-top:0}
    label{display:flex;align-items:center;gap:8px;padding:3px 2px;cursor:pointer;border-radius:5px}
    label:hover{background:rgba(255,255,255,.07)}
    input[type=checkbox]{accent-color:#4d8dff;width:14px;height:14px;margin:0}
    .acts{display:flex;gap:6px;margin-top:8px}
    .acts button{flex:1;padding:4px 0;border-radius:6px;border:1px solid rgba(255,255,255,.2);cursor:pointer;
      background:rgba(255,255,255,.08);color:#e8eefc;font:inherit;font-size:12px}
    .acts button:hover{background:rgba(255,255,255,.18)}
    .acts .rec,.rec{width:100%;padding:6px 0;margin-bottom:6px;border-radius:7px;border:1px solid #ffd166;cursor:pointer;
      background:rgba(255,209,102,.14);color:#ffd166;font:inherit;font-weight:600}
    .rec:hover{background:rgba(255,209,102,.28)}
    select{width:100%;padding:4px 6px;border-radius:6px;background:#1a2547;color:#e8eefc;border:1px solid rgba(255,255,255,.2);font:inherit}
    canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
    .toast{position:absolute;left:50%;top:14%;transform:translateX(-50%);padding:7px 14px;border-radius:9px;
      background:rgba(10,20,48,.9);border:1px solid rgba(255,255,255,.25);color:#fff;font-size:14px;
      opacity:0;transition:opacity .25s;pointer-events:none;white-space:nowrap}
    .toast.on{opacity:1}
    .menu h4 small{text-transform:none;letter-spacing:0;opacity:.7;font-weight:400}
    .hint{margin-top:8px;font-size:11px;color:#7d8db3}
    .mini{position:absolute;left:10px;bottom:10px;display:none;overflow:hidden}
    .mini .title{margin:0;padding:5px 8px}
    .mini canvas{position:static;inset:auto;display:block}
  </style>
  <canvas id="ov"></canvas>
  <div class="toast" id="toast"></div>
  <input type="file" id="imp" accept="application/json,.json" style="display:none">
  <div class="panel" id="panel"><div class="title" id="drag"><i></i>PokéSurvivor HUD<small>⠿</small></div><div id="body"></div></div>
  <div class="mini" id="mini"><div class="title" id="mdrag"><i></i>Aliados<small>⠿</small></div><canvas id="mcv"></canvas></div>
  <div class="menu" id="menu"></div>
  <div class="btn" id="btn" title="Opciones del HUD">⚙</div>`;
  document.documentElement.appendChild(host);

  const $ = id => root.getElementById(id);
  const panel = $('panel'), body = $('body'), handle = $('drag'), menu = $('menu'), btn = $('btn');
  const mini = $('mini'), miniHandle = $('mdrag'), mcv = $('mcv');

  // que el juego no reciba nuestros clics/toques
  for (const el of [btn, menu, handle, miniHandle])
    for (const ev of ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'touchstart', 'touchend', 'click', 'contextmenu'])
      el.addEventListener(ev, e => e.stopPropagation());
  btn.addEventListener('click', () => menu.classList.toggle('open'));

  /* ---------- MENÚ ---------- */
  const chk = (k, text, on) => `<label><input type="checkbox" data-k="${esc(k)}" ${on ? 'checked' : ''}>${esc(text)}</label>`;

  const OPT_WORLD = [
    ['ring', 'Eficacia de tipo bajo cada enemigo'], ['support', 'Resaltar curanderos, escudos e invocadores'],
    ['bossHp', 'Vida numérica de los jefes'], ['haz', 'Avisos de ataque más visibles'],
    ['magnet', 'Círculo del imán'], ['arrows', 'Flechas a jefes y duende del tesoro'],
    ['poi', 'Flechas a altares, manantiales, cofres y grietas']];
  const OPT_QOL = [
    ['pauseBlur', 'Pausar al salir de la pestaña'], ['shiftWheel', 'Mayús + rueda: cambiar de ataque'],
    ['alerts', 'Avisos y sonido (shiny, duende, grieta)'], ['title', 'Vida y tiempo en el título de la pestaña'],
    ['autoMove', 'Cambio automático de ataque (solo en solitario)']];

  const TABS = [['panel', 'Panel'], ['stats', 'Estadísticas'], ['world', 'Mundo'], ['extras', 'Extras']];

  function setTab(t) {
    if (!TABS.some(x => x[0] === t)) t = 'panel';
    cfg.tab = t; save();
    for (const b of menu.querySelectorAll('[data-tab]')) b.classList.toggle('on', b.dataset.tab === t);
    for (const pn of menu.querySelectorAll('.pane')) pn.classList.toggle('on', pn.dataset.pane === t);
  }

  function buildMenu() {
    menu.innerHTML = `
      <div class="tabs">${TABS.map(([k, n]) => `<button data-tab="${k}">${n}</button>`).join('')}</div>

      <div class="pane" data-pane="panel">
        <h4>Qué mostrar</h4>
        ${chk('panel', 'Panel de estadísticas', cfg.panel)}
        ${chk('fps', 'FPS', cfg.fps)}
        ${chk('fov', 'Campo de visión (zoom)', cfg.fov)}
        ${chk('hp', 'Barra de vida', cfg.hp)}
        ${chk('xp', 'Barra de experiencia', cfg.xp)}
        <h4>Minimapa de aliados</h4>
        ${chk('mini', 'Mostrar minimapa', cfg.mini)}
        <select data-k="miniSize">
          <option value="small">Tamaño pequeño</option><option value="medium">Tamaño mediano</option><option value="large">Tamaño grande</option>
        </select>
        <select data-k="miniRange" style="margin-top:6px">
          <option value="near">Alcance cercano</option><option value="mid">Alcance medio</option><option value="far">Alcance lejano</option>
        </select>
        <div class="hint">Arrastra el panel o el minimapa por su título · doble clic = posición original · F8 = ocultar panel</div>
      </div>

      <div class="pane" data-pane="stats">
        <h4>Estadísticas del jugador</h4>
        ${STATS.map(s => chk('s:' + s.k, s.label, !cfg.hidden[s.k])).join('')}
        <div class="acts"><button data-a="all">Todo</button><button data-a="none">Nada</button></div>
      </div>

      <div class="pane" data-pane="world">
        <h4>Barra de vida de enemigos</h4>
        <select data-k="hpbar">
          <option value="normal">Normal</option><option value="big">Grande</option><option value="huge">Enorme</option>
        </select>
        <h4>Sobre el mapa <small>(B jefe · $ duende · A altar · + manantial · C cofre · R grieta)</small></h4>
        ${OPT_WORLD.map(([k, t]) => chk(k, t, cfg[k])).join('')}
      </div>

      <div class="pane" data-pane="extras">
        <h4>Comodidad y ventaja</h4>
        ${OPT_QOL.map(([k, t]) => chk(k, t, cfg[k])).join('')}
        <h4>Guardado</h4>
        <div class="acts"><button data-a="export">Exportar</button><button data-a="import">Importar</button></div>
        <div class="hint">Rueda = zoom · Inicio = reset zoom · Mayús + rueda = cambiar de ataque · / = buscar en la colección</div>
      </div>

      <div class="foot"><div class="acts"><button class="rec" data-a="reco">★ Recomendado</button><button data-a="reset">Reset</button></div></div>`;
    setTab(cfg.tab);
  }

  menu.addEventListener('change', e => {
    const k = e.target.dataset.k; if (!k) return;
    if (k.startsWith('s:')) { if (e.target.checked) delete cfg.hidden[k.slice(2)]; else cfg.hidden[k.slice(2)] = 1; }
    else cfg[k] = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
    save(); render();
  });
  menu.addEventListener('click', e => {
    const tab = e.target.dataset.tab;
    if (tab) { setTab(tab); return; }
    const a = e.target.dataset.a; if (!a) return;
    if (a === 'all') cfg.hidden = {};
    if (a === 'none') cfg.hidden = Object.fromEntries(STATS.map(s => [s.k, 1]));
    if (a === 'reset') cfg = { ...DEF, hidden: nonReco(), pos: null, tab: cfg.tab };
    if (a === 'reco') cfg = { ...DEF, hidden: nonReco(), pos: cfg.pos, miniPos: cfg.miniPos, tab: cfg.tab };
    if (a === 'export') return exportSave();
    if (a === 'import') return $('imp').click();
    save(); render();
  });
  buildMenu();

  /* ---------- ARRASTRAR PANEL Y MINIMAPA ---------- */
  const lim = (v, a, b) => Math.max(a, Math.min(b, v));
  /** Hace arrastrable `el` por `handle`; la posición se guarda en cfg[key] ({x,y} o null = la de por defecto).
      Devuelve la función que aplica la posición guardada. */
  function setupDrag(el, handle, key) {
    const apply = () => {
      const pos = cfg[key];
      if (!pos) { el.style.left = el.style.top = el.style.right = el.style.bottom = el.style.transform = ''; return; }
      const x = lim(pos.x, 0, Math.max(0, innerWidth - el.offsetWidth));
      const y = lim(pos.y, 0, Math.max(0, innerHeight - el.offsetHeight));
      Object.assign(el.style, { left: x + 'px', top: y + 'px', right: 'auto', bottom: 'auto', transform: 'none' });
    };
    let drag = null;
    handle.addEventListener('pointerdown', e => {
      if (e.button) return;
      if (!cfg[key]) { const r = el.getBoundingClientRect(); cfg[key] = { x: r.left, y: r.top }; apply(); }
      drag = { dx: e.clientX - cfg[key].x, dy: e.clientY - cfg[key].y };
      handle.classList.add('drag'); handle.setPointerCapture(e.pointerId);
    });
    handle.addEventListener('pointermove', e => {
      if (!drag) return;
      cfg[key] = { x: e.clientX - drag.dx, y: e.clientY - drag.dy };
      apply();
    });
    const end = () => { if (!drag) return; drag = null; handle.classList.remove('drag'); save(); };
    handle.addEventListener('pointerup', end);
    handle.addEventListener('pointercancel', end);
    handle.addEventListener('dblclick', () => { cfg[key] = null; save(); apply(); });
    return apply;
  }
  const applyPos = setupDrag(panel, handle, 'pos');
  const applyMiniPos = setupDrag(mini, miniHandle, 'miniPos');
  addEventListener('resize', () => { applyPos(); applyMiniPos(); });

  /* ---------- RENDER ---------- */
  let player = null, lastScan = 0, frames = 0, fps = 0, t0 = performance.now();
  (function loop(t) { frames++; if (t - t0 >= 1000) { fps = frames; frames = 0; t0 = t; } requestAnimationFrame(loop); })(t0);

  const row = (l, v, cls = '') => `<div class="row"><span>${esc(l)}</span><b class="${cls}">${v}</b></div>`;
  const bar = (label, text, pct, color) => `<div class="bar"><div class="lbl"><span>${label}</span><b>${text}</b></div>
    <div class="track"><div class="fill" style="width:${pct * 100}%;background:${color}"></div></div></div>`;

  function render() {
    // Se vuelve a buscar al jugador cada 300 ms: así se engancha al nuevo al empezar otra partida
    // (el anterior sigue "válido" en `instances`, por eso no basta con comprobar si lo es).
    const now = performance.now();
    if (now - lastScan > 300) { player = currentPlayer(); lastScan = now; }
    const p = isPlayer(player) ? player : null;
    tick(p);

    for (const i of menu.querySelectorAll('[data-k]')) {            // sincroniza controles (p. ej. tras F8 o Recomendado)
      const k = i.dataset.k;
      if (i.tagName === 'SELECT') { if (i.value !== cfg[k]) i.value = cfg[k]; continue; }
      const on = k.startsWith('s:') ? !cfg.hidden[k.slice(2)] : cfg[k];
      if (i.checked !== !!on) i.checked = !!on;
    }

    let h = '';
    if (cfg.fps) h += row('FPS', fps, fps >= 55 ? 'good' : fps >= 30 ? 'warn' : 'bad');
    if (cfg.fov) h += row('Campo de visión', `${Z.toFixed(2)}×`);
    if (p) {
      if (cfg.hp) {
        const f = p.maxHp > 0 ? lim(p.hp / p.maxHp, 0, 1) : 0;
        h += bar('Vida', `${fmt(Math.ceil(p.hp))} / ${fmt(Math.round(p.maxHp))}`, f, f > .5 ? '#46d37a' : f > .25 ? '#ffd166' : '#ff5c5c');
      }
      if (cfg.xp) h += bar('XP', `${fmt(Math.floor(p.xp))} / ${fmt(p.xpNext)}`, p.xpNext > 0 ? lim(p.xp / p.xpNext, 0, 1) : 0, '#4d8dff');
      const rows = [];
      for (const s of STATS) {
        if (cfg.hidden[s.k]) continue;
        let v; try { v = s.get(p); } catch { continue; }
        rows.push(row(s.label, fmt(v)));
      }
      if (rows.length && h) h += '<div class="sep"></div>';
      h += rows.join('');
    } else if (cfg.panel) h += '<div class="sep"></div><div class="empty">Esperando partida…</div>';

    panel.style.display = cfg.panel && h ? 'block' : 'none';
    body.innerHTML = h;
    applyPos();
    applyMiniPos();
  }

  /* ---------- AVISOS, GUARDADO, TÍTULO ---------- */
  const toastEl = $('toast'); let toastT = 0;
  function toast(msg, ms = 2600) {
    toastEl.textContent = msg; toastEl.classList.add('on');
    clearTimeout(toastT); toastT = setTimeout(() => toastEl.classList.remove('on'), ms);
  }
  let ac = null;
  function beep(f = 880, d = 0.16) {
    try {
      ac = ac || new (window.AudioContext || window.webkitAudioContext)();
      if (ac.state === 'suspended') ac.resume();
      const o = ac.createOscillator(), g = ac.createGain(), t = ac.currentTime;
      o.type = 'triangle'; o.frequency.value = f;
      g.gain.setValueAtTime(0.06, t); g.gain.exponentialRampToValueAtTime(0.0001, t + d);
      o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t + d);
    } catch {}
  }
  const alertUser = (msg, f) => { toast(msg); beep(f); setTimeout(() => beep(f * 1.26), 140); };

  function exportSave() {
    const data = {};
    for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); data[k] = localStorage.getItem(k); }
    const blob = new Blob([JSON.stringify({ game: 'pokesurvivor', exported: new Date().toISOString(), origin: location.origin, data }, null, 1)],
      { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `pokesurvivor-guardado-${new Date().toISOString().slice(0, 10)}.json`;
    document.documentElement.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    toast('Guardado exportado');
  }
  $('imp').addEventListener('change', async e => {
    const f = e.target.files[0]; e.target.value = '';
    if (!f) return;
    try {
      const j = JSON.parse(await f.text()), d = j && j.data;
      if (!d || typeof d !== 'object') throw new Error('formato');
      if (!confirm(`¿Importar ${Object.keys(d).length} entradas del guardado del ${String(j.exported || '').slice(0, 10)}?\nSobrescribe el guardado actual de este navegador (haz esto desde el menú principal).`)) return;
      for (const [k, v] of Object.entries(d)) localStorage.setItem(k, v);
      toast('Guardado importado. Recargando…', 2000);
      setTimeout(() => location.reload(), 700);
    } catch { toast('Archivo no válido'); }
  });

  /* ---------- PUNTOS DE INTERÉS (altares, manantiales, cofres, grietas) ----------
     Sin ver interact.js se buscan, dentro de G, listas de objetos con x/y cuyo nombre (o tipo) los delate. */
  const POI_RE = [['altar', /altar/i], ['spring', /spring|manantial/i], ['chest', /chest|cofre/i], ['rift', /rift|grieta|portal/i]];
  const kindOfStr = t => { for (const [k, r] of POI_RE) if (r.test(t)) return k; return null; };
  const spent = o => o.done || o.used || o.opened || o.taken || o.collected || o.dead || o.gone || o.claimed;
  let pois = [], lastScan2 = 0;
  function scanPOIs() {
    const G = gl(); if (!G) return;
    const out = [], seen = new Set();
    const visit = (o, key, depth) => {
      if (!o || typeof o !== 'object' || seen.has(o) || o instanceof Node) return;
      seen.add(o);
      const arr = Array.isArray(o) ? o : o instanceof Map ? [...o.values()] : null;
      if (arr) {
        if (arr.length > 400) return;
        const kk = kindOfStr(key || '');
        for (const it of arr) {
          if (!it || typeof it !== 'object' || typeof it.x !== 'number' || typeof it.y !== 'number' || spent(it)) continue;
          const k = kk || kindOfStr(String(it.type || it.kind || it.id || it.name || ''));
          if (k) out.push({ kind: k, x: it.x, y: it.y });
        }
        return;
      }
      if (typeof o.x === 'number' && typeof o.y === 'number') {
        const k = kindOfStr(key || '') || kindOfStr(String(o.type || o.kind || o.id || o.name || ''));
        if (k && !spent(o)) out.push({ kind: k, x: o.x, y: o.y });
        return;
      }
      if (depth >= 2) return;
      let keys; try { keys = Object.keys(o); } catch { return; }
      if (keys.length > 60) return;
      for (const k of keys) { let v; try { v = o[k]; } catch { continue; } if (v && typeof v === 'object') visit(v, k, depth + 1); }
    };
    for (const r of [G.Interact, G.World, G.Rift, G.Events]) visit(r, '', 0);
    pois = out.slice(0, 80);
  }
  window.__PS = { pois: () => pois, player: () => player, hazards: () => hazards };   // para depurar desde la consola

  /* ---------- TICK (4 veces por segundo): métricas, avisos, título, auto-cambio ---------- */
  let lastP = null, samples = [], seenIds = new Set(), seenPoi = new Set(), lastAuto = -1e9, lastAutoPause = -1e9, baseTitle = '';
  const inRun = p => p && performance.now() - (p._psUpd || 0) < 1500;

  function tick(p) {
    const G = gl(), now = performance.now();
    if (p !== lastP) { lastP = p; hazards.length = 0; samples = []; seenIds.clear(); seenPoi.clear(); pois = []; metrics.dps = 0; }
    if (!/^❤/.test(document.title)) baseTitle = document.title;
    if (!p || !inRun(p)) { if (/^❤/.test(document.title)) document.title = baseTitle; return; }

    const t = p._psTime || 0;                                        // DPS con reloj de juego (respeta la pausa)
    samples.push([t, p.dmgDealt || 0]);
    while (samples.length > 2 && t - samples[0][0] > 5) samples.shift();
    const a = samples[0];
    metrics.dps = t - a[0] > 0.4 ? Math.max(0, ((p.dmgDealt || 0) - a[1]) / (t - a[0])) : 0;

    if (cfg.alerts && G?.EnemyMgr) {
      for (const e of G.EnemyMgr.all()) {
        if (e.dead || seenIds.has(e.id)) continue;
        if (e.shiny) { seenIds.add(e.id); alertUser(`✨ ¡Shiny: ${e.name}!`, 1175); }
        else if (e.behavior === 'thief') { seenIds.add(e.id); alertUser(`💰 ¡${e.name}, duende del tesoro!`, 988); }
      }
    }
    if ((cfg.poi || cfg.alerts) && now - lastScan2 > 1000) {
      lastScan2 = now; scanPOIs();
      for (const q of pois) {
        if (q.kind !== 'rift') continue;
        const key = `${Math.round(q.x / 40)}:${Math.round(q.y / 40)}`;
        if (!seenPoi.has(key)) { seenPoi.add(key); if (cfg.alerts) alertUser('🌀 ¡Se ha abierto una grieta!', 660); }
      }
    }
    if (cfg.title) document.title = `❤ ${Math.ceil(p.hp)}/${Math.round(p.maxHp)} · ${fmtT(t)} · ${baseTitle || 'PokéSurvivor'}`;
    else if (/^❤/.test(document.title)) document.title = baseTitle;

    // Cambio automático de ataque: opt-in, nunca en cooperativo, con histéresis para no perder recarga.
    if (cfg.autoMove && !G?.Coop?.active && !p.dead && p.slots && p.slots.length > 1 && now - lastAuto > 3000) {
      const b = bestSlot(p);
      if (b && b.best !== p.active && b.bm >= b.cur * 1.5 + 0.01) { lastAuto = now; p.setActive(b.best); }
    }
  }

  /* ---------- PAUSA AL SALIR DE LA PESTAÑA ---------- */
  function autoPause() {
    const now = performance.now();
    if (!cfg.pauseBlur || now - lastAutoPause < 2000) return;
    const G = gl(), p = player;
    if (!isPlayer(p) || p.dead || G?.Coop?.active || now - (p._psUpd || 0) > 400) return;   // solo si el juego corre ahora mismo
    lastAutoPause = now;
    for (const type of ['keydown', 'keyup'])
      document.dispatchEvent(new KeyboardEvent(type, { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true }));
  }
  document.addEventListener('visibilitychange', () => { if (document.hidden) autoPause(); });
  addEventListener('blur', autoPause);

  /* ---------- OVERLAY EN EL MUNDO ---------- */
  const cv = $('ov'), octx = cv.getContext('2d');
  let gc = null;
  const getGC = () => (gc && gc.isConnected) ? gc :
    (gc = [...document.querySelectorAll('canvas')].filter(c => c !== cv && c.clientWidth > 300)
      .sort((a, b) => b.clientWidth * b.clientHeight - a.clientWidth * a.clientHeight)[0] || null);

  function badge(x, y, ang, col, glyph) {
    octx.save(); octx.translate(x, y); octx.globalAlpha = 0.92;
    octx.fillStyle = col; octx.strokeStyle = 'rgba(0,0,0,.7)'; octx.lineWidth = 2;
    octx.beginPath(); octx.arc(0, 0, 11, 0, 6.2832); octx.fill(); octx.stroke();
    octx.rotate(ang); octx.beginPath(); octx.moveTo(20, 0); octx.lineTo(11, -6.5); octx.lineTo(11, 6.5); octx.closePath(); octx.fill(); octx.stroke();
    octx.rotate(-ang);
    octx.fillStyle = '#10151f'; octx.font = '700 12px sans-serif'; octx.textAlign = 'center'; octx.textBaseline = 'middle';
    octx.fillText(glyph, 0, 1); octx.restore();
  }
  const POI_STYLE = { altar: ['#c47bff', 'A'], spring: ['#5fe08a', '+'], chest: ['#ffd23f', 'C'], rift: ['#9ae6ff', 'R'] };

  /* ---------- MINIMAPA DE ALIADOS ----------
     Centrado en tu Pokémon. Los compañeros de cooperativo salen con su color y la inicial de su nombre;
     si están más lejos que el alcance, se pegan al borde del círculo. Caído = gris con ✕ y aro rojo. */
  const MINI_SIZES = { small: 120, medium: 160, large: 220 };
  const MINI_RANGE = { near: 700, mid: 1200, far: 2000 };
  const mctx = mcv.getContext('2d');
  let miniKey = '';
  function miniFrame() {
    const G = gl(), st = G?.Game?.state;
    const p = isPlayer(player) ? player : null;
    const show = !!(cfg.mini && p && st && st !== 'ui' && st !== 'over');
    mini.style.display = show ? 'block' : 'none';
    if (!show) return;
    const S = MINI_SIZES[cfg.miniSize] || 160, R = MINI_RANGE[cfg.miniRange] || 1200;
    const dpr = window.devicePixelRatio || 1, key = S + '@' + dpr;
    if (key !== miniKey) {
      miniKey = key;
      mcv.width = mcv.height = Math.round(S * dpr);
      mcv.style.width = mcv.style.height = S + 'px';
    }
    mctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    mctx.clearRect(0, 0, S, S);
    const c = S / 2, rr = c - 8, k = rr / R, now = performance.now();

    // anillos de alcance y cruz
    mctx.strokeStyle = 'rgba(255,255,255,.14)'; mctx.lineWidth = 1;
    for (const f of [1, 0.5]) { mctx.beginPath(); mctx.arc(c, c, rr * f, 0, 6.2832); mctx.stroke(); }
    mctx.beginPath(); mctx.moveTo(c, 4); mctx.lineTo(c, S - 4); mctx.moveTo(4, c); mctx.lineTo(S - 4, c); mctx.stroke();

    // aliados
    const mates = (G?.Coop?.active ? G.Coop.mates : []).filter(m => m.connected && m.pl);
    for (const m of mates) {
      const n = m.pl.net, ax = n ? n.x : m.pl.x, ay = n ? n.y : m.pl.y, dead = n ? !!n.dead : !!m.pl.dead;
      let dx = (ax - p.x) * k, dy = (ay - p.y) * k;
      const d = Math.hypot(dx, dy), edge = d > rr;
      if (edge) { dx *= rr / d; dy *= rr / d; }
      const x = c + dx, y = c + dy;
      mctx.save();
      if (dead) {
        mctx.globalAlpha = 0.6 + 0.4 * Math.sin(now / 200); mctx.lineWidth = 2; mctx.strokeStyle = '#ff5c5c';
        mctx.beginPath(); mctx.arc(x, y, 9, 0, 6.2832); mctx.stroke();
      }
      mctx.globalAlpha = edge ? 0.75 : 1;
      mctx.beginPath(); mctx.arc(x, y, 6, 0, 6.2832);
      mctx.fillStyle = dead ? '#6b7388' : (m.color || '#ffcb3d'); mctx.fill();
      mctx.lineWidth = 2; mctx.strokeStyle = 'rgba(0,0,0,.75)'; mctx.stroke();
      mctx.fillStyle = '#10151f'; mctx.font = '700 9px sans-serif'; mctx.textAlign = 'center'; mctx.textBaseline = 'middle';
      mctx.fillText(dead ? '✕' : String(m.name || '?').charAt(0).toUpperCase(), x, y + 0.5);
      mctx.restore();
    }
    if (!mates.length) {
      mctx.fillStyle = 'rgba(159,176,212,.85)'; mctx.font = '10px sans-serif'; mctx.textAlign = 'center'; mctx.textBaseline = 'bottom';
      mctx.fillText('Sin aliados', c, S - 6);
    }

    // tú, en el centro (el triángulo apunta hacia donde te mueves)
    mctx.save(); mctx.translate(c, c);
    mctx.fillStyle = '#fff'; mctx.strokeStyle = 'rgba(0,0,0,.8)'; mctx.lineWidth = 2;
    mctx.beginPath();
    if (typeof p.moveAngle === 'number') {
      mctx.rotate(p.moveAngle);
      mctx.moveTo(9, 0); mctx.lineTo(-5, -5.5); mctx.lineTo(-5, 5.5); mctx.closePath();
    } else mctx.arc(0, 0, 5, 0, 6.2832);
    mctx.stroke(); mctx.fill(); mctx.restore();
  }

  function frame() {
    requestAnimationFrame(frame);
    miniFrame();
    const dpr = window.devicePixelRatio || 1, W = innerWidth, H = innerHeight;
    if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); }
    octx.setTransform(1, 0, 0, 1, 0, 0); octx.clearRect(0, 0, cv.width, cv.height);
    const G = gl(), C = Cam, p = player;
    if (!G || !C || !C.w || !isPlayer(p) || !inRun(p)) return;
    const g = getGC(); if (!g) return;
    const r = g.getBoundingClientRect(); if (r.width < 10) return;
    octx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const k = r.width / C.w, L = C.left() - (C._sx || 0), T = C.top() - (C._sy || 0);
    const X = wx => (wx - L) * k + r.left, Y = wy => (wy - T) * k + r.top;
    const clock = p._psTime || 0, now = performance.now();

    // Avisos de ataque (zonas y rayos): relleno, contorno y anillo que se cierra al detonar.
    for (let i = hazards.length - 1; i >= 0; i--) {
      const h = hazards[i], el = clock - h.t0, delay = h.delay || 1;
      if (el > delay + 0.3 || el < -1) { hazards.splice(i, 1); continue; }
      if (!cfg.haz) continue;
      const col = h.color || '#ff5252', prog = Math.max(0, Math.min(1, el / delay));
      octx.save();
      if (h.kind === 'zone') {
        const x = X(h.x), y = Y(h.y), rr = (h.r || 40) * k;
        octx.beginPath(); octx.arc(x, y, rr, 0, 6.2832);
        octx.globalAlpha = 0.1 + 0.14 * prog; octx.fillStyle = col; octx.fill();
        octx.globalAlpha = 0.95; octx.lineWidth = 3; octx.strokeStyle = '#fff'; octx.stroke();
        octx.beginPath(); octx.arc(x, y, Math.max(1, rr * prog), 0, 6.2832);
        octx.lineWidth = 2.5; octx.strokeStyle = col; octx.stroke();
      } else if (h.kind === 'beam') {
        octx.translate(X(h.x), Y(h.y)); octx.rotate(h.angle || 0);
        const len = (h.len || 300) * k, w = (h.w || 20) * k;
        octx.globalAlpha = 0.1 + 0.16 * prog; octx.fillStyle = col; octx.fillRect(0, -w / 2, len, w);
        octx.globalAlpha = 0.95; octx.lineWidth = 2.5; octx.strokeStyle = '#fff'; octx.strokeRect(0, -w / 2, len, w);
      }
      octx.restore();
    }

    // Círculo del imán
    if (cfg.magnet && p.magnet) {
      octx.save(); octx.setLineDash([7, 7]); octx.globalAlpha = 0.4; octx.strokeStyle = '#7fe0ff'; octx.lineWidth = 2;
      octx.beginPath(); octx.arc(X(p.x), Y(p.y), p.magnet * k, 0, 6.2832); octx.stroke(); octx.restore();
    }

    // Enemigos: anillos de eficacia / apoyos / vida de jefes; flechas a los fuera de pantalla
    const grp = p.activeGroup ? p.activeGroup() : [];
    const m0 = r.left + 6, m1 = r.right - 6, n0 = r.top + 6, n1 = r.bottom - 6;
    const cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2, edge = 24;
    const arrowTo = (wx, wy, col, glyph) => {
      const dx = X(wx) - cx, dy = Y(wy) - cy;
      const t = Math.min((cx - r.left - edge) / Math.abs(dx || 1e-6), (cy - r.top - edge) / Math.abs(dy || 1e-6));
      badge(cx + dx * t, cy + dy * t, Math.atan2(dy, dx), col, glyph);
    };
    const enemies = G.EnemyMgr ? G.EnemyMgr.all() : [];
    for (const e of enemies) {
      if (e.dead) continue;
      const x = X(e.x), y = Y(e.y), on = x > m0 && x < m1 && y > n0 && y < n1;
      if (!on) {
        if (cfg.arrows) { if (e.boss) arrowTo(e.x, e.y, '#ff5252', 'B'); else if (e.behavior === 'thief') arrowTo(e.x, e.y, '#ffd23f', '$'); }
        continue;
      }
      const rx = (e.r || 10) * k;
      if (cfg.ring && grp.length && G.Types && e.types) {
        let s = 0; for (const m of grp) s += G.Types.mult(m.type, e.types);
        const mul = s / grp.length;
        if (Math.abs(mul - 1) > 0.01) {
          octx.beginPath(); octx.ellipse(x, y, rx * 1.3, rx * 0.55, 0, 0, 6.2832);
          octx.globalAlpha = 0.85; octx.lineWidth = 2;
          octx.strokeStyle = mul >= 2 ? '#46d37a' : mul > 1 ? '#a6e36a' : mul === 0 ? '#9b59d0' : '#ff6b6b';
          octx.stroke(); octx.globalAlpha = 1;
        }
      }
      if (cfg.support && (e.behavior === 'healer' || e.behavior === 'shielder' || e.behavior === 'summoner')) {
        octx.save(); octx.setLineDash([5, 4]); octx.lineWidth = 2.5;
        octx.globalAlpha = 0.65 + 0.3 * Math.sin(now / 180);
        octx.strokeStyle = e.behavior === 'healer' ? '#5fe08a' : e.behavior === 'shielder' ? '#7fc8ff' : '#c47bff';
        octx.beginPath(); octx.ellipse(x, y, rx * 1.8, rx * 0.8, 0, 0, 6.2832); octx.stroke(); octx.restore();
      }
      if (cfg.bossHp && e.boss) {
        const txt = `${fmt(Math.ceil(e.hp))} / ${fmt(e.maxHp)} · ${Math.round(100 * e.hp / e.maxHp)}%`;
        octx.font = '700 12px sans-serif'; octx.textAlign = 'center'; octx.textBaseline = 'bottom';
        octx.lineWidth = 3; octx.strokeStyle = 'rgba(0,0,0,.85)'; octx.fillStyle = '#fff';
        const ty = y - ((e.bodyH || 30) + 16) * k;
        octx.strokeText(txt, x, ty); octx.fillText(txt, x, ty);
      }
    }

    // Flechas a altares, manantiales, cofres y grietas (las 2 más cercanas de cada tipo)
    if (cfg.poi) {
      const byKind = {};
      for (const q of pois) (byKind[q.kind] = byKind[q.kind] || []).push(q);
      for (const kind in byKind) {
        byKind[kind].sort((a, b) => (a.x - p.x) ** 2 + (a.y - p.y) ** 2 - ((b.x - p.x) ** 2 + (b.y - p.y) ** 2));
        for (const q of byKind[kind].slice(0, 2)) {
          const x = X(q.x), y = Y(q.y);
          if (x > m0 && x < m1 && y > n0 && y < n1) continue;
          const [col, gl2] = POI_STYLE[kind]; arrowTo(q.x, q.y, col, gl2);
        }
      }
    }
  }
  requestAnimationFrame(frame);

  /* ---------- BUSCADOR EN LA COLECCIÓN (pantalla #scr-dex de menu.js) ----------
     Filtra las tarjetas de la generación abierta, indica en qué otras generaciones hay resultados
     (botones) y salta sola a una con resultados. Nombre y tipos solo de los que ya tienes; el nº, de todos. */
  (() => {
    const norm = t => String(t).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const FKEYS = ['all', 'own', 'miss', 'shiny', '5', '4', '3', '2', '1'];    // mismo orden que los chips del juego
    let index = null, byDex = null, input = null, hits = null, q = '', tokens = [];

    function getIndex() {
      const G = gl(); if (!G || !G.DEX) return null;
      if (index && index.length === G.DEX.length) return index;
      index = G.DEX.map(p => {
        let tn = ''; try { tn = String(G.UI.typeChips(p.types)).replace(/<[^>]*>/g, ' '); } catch {}
        return { p, name: norm(p.name), types: norm(tn + ' ' + (p.types || []).join(' ')), no: String(p.dex).padStart(3, '0') };
      });
      byDex = new Map(index.map(it => [it.p.dex, it]));
      return index;
    }
    const nativeFilter = () => {
      const i = [...document.querySelectorAll('#dex-filters .chip')].findIndex(c => c.classList.contains('on'));
      return FKEYS[i] || 'all';
    };
    const passNative = (p, f, sv) => {
      const own = !!sv.owned[p.dex], sh = !!(sv.shiny && sv.shiny[p.dex]);
      return !((f === 'own' && !own) || (f === 'miss' && own) || (f === 'shiny' && !sh) || (/^\d$/.test(f) && p.rarity !== +f));
    };
    function matches(it, owned) {
      if (!q) return true;
      if (/^\d+$/.test(q)) return it.no.includes(q);
      if (!owned) return false;
      const hay = it.name + ' ' + it.types;
      return tokens.every(t => hay.includes(t));
    }
    const curGen = () => [...document.querySelectorAll('#dex-gens .gen-tab')].findIndex(b => b.classList.contains('on')) + 1;

    function applyFilter() {
      const G = gl(), grid = document.getElementById('dex-grid');
      if (!G?.DB?.save || !grid || !getIndex()) return;
      const sv = G.DB.save;
      for (const cell of grid.children) {
        const no = cell.querySelector('.no'); if (!no) continue;
        const it = byDex.get(parseInt(no.textContent, 10)); if (!it) continue;
        cell.style.display = matches(it, !!sv.owned[it.p.dex]) ? '' : 'none';
      }
    }

    function counts() {
      const G = gl(), sv = G?.DB?.save, out = {};
      if (!sv || !getIndex() || !q) return out;
      const f = nativeFilter();
      for (const it of index) if (passNative(it.p, f, sv) && matches(it, !!sv.owned[it.p.dex])) out[it.p.gen] = (out[it.p.gen] || 0) + 1;
      return out;
    }

    function updateHits() {
      const G = gl(); hits.textContent = '';
      if (!q) return;
      const c = counts(), gens = Object.keys(c).map(Number);
      if (!gens.length) { hits.textContent = 'Sin resultados' + (/^\d+$/.test(q) ? '' : ' (el nombre solo se busca entre los que ya tienes)'); hits.style.opacity = .7; return; }
      hits.style.opacity = 1;
      const cur = curGen(), names = G?.MenuUI?.GEN_NAMES || [];
      for (const g of gens) {
        const b = document.createElement('button');
        b.className = 'chip' + (g === cur ? ' on' : '');
        b.textContent = `${names[g - 1] || 'Gen ' + g} · ${c[g]}`;
        b.onclick = () => gotoGen(g);
        hits.appendChild(b);
      }
    }
    function gotoGen(g) {
      const tab = document.querySelectorAll('#dex-gens .gen-tab')[g - 1];
      if (tab && g !== curGen()) tab.click();
    }
    function refresh(auto) {
      updateHits(); applyFilter();
      if (auto && q) {
        const c = counts(), cur = curGen();
        if (!c[cur]) { const first = Object.keys(c).map(Number).sort((a, b) => a - b)[0]; if (first) gotoGen(first); }
      }
    }
    function pickFirst() {
      const G = gl(), sv = G?.DB?.save; if (!sv || !q || !getIndex()) return;
      const f = nativeFilter();
      const it = index.find(x => passNative(x.p, f, sv) && matches(x, !!sv.owned[x.p.dex]));
      if (!it) return;
      gotoGen(it.p.gen);
      const cell = [...document.getElementById('dex-grid').children].find(c => c.querySelector('.no')?.textContent === it.no);
      if (cell) cell.click();                                   // abre su ficha, como al pulsar la tarjeta
    }

    function install(fb, grid) {
      const box = document.createElement('div');
      box.style.cssText = 'flex:1 0 100%;width:100%;margin:6px 0';
      box.innerHTML = '<input class="field" type="search" autocomplete="off" spellcheck="false" ' +
        'placeholder="Buscar por nombre, tipo o nº…  ( / )" style="width:100%;box-sizing:border-box">' +
        '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;font-size:13px"></div>';
      input = box.firstChild; hits = box.lastChild;
      fb.insertAdjacentElement('afterend', box);
      input.addEventListener('input', () => { q = norm(input.value); tokens = q.split(/\s+/).filter(Boolean); refresh(true); });
      for (const ev of ['keydown', 'keyup', 'keypress']) input.addEventListener(ev, e => {
        e.stopPropagation();                                    // que las teclas no lleguen a los atajos del juego
        if (ev !== 'keydown') return;
        if (e.key === 'Enter') { e.preventDefault(); pickFirst(); }
        if (e.key === 'Escape') { input.value = ''; q = ''; tokens = []; refresh(false); input.blur(); }
      });
      // Cada vez que menu.js redibuja la rejilla (cambio de generación o filtro), se reaplica la búsqueda.
      new MutationObserver(() => { applyFilter(); updateHits(); }).observe(grid, { childList: true });
    }

    const wait = setInterval(() => {
      const fb = document.getElementById('dex-filters'), grid = document.getElementById('dex-grid');
      if (!fb || !grid || input) return;
      install(fb, grid); clearInterval(wait);
    }, 300);

    addEventListener('keydown', e => {                          // "/" enfoca el buscador desde la colección
      if (e.key !== '/' || !input || e.ctrlKey || e.metaKey || e.altKey) return;
      const a = document.activeElement;
      if (a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName)) return;
      let open = false; try { open = !!gl()?.UI?.isOpen('scr-dex'); } catch {}
      if (open) { e.preventDefault(); input.focus(); input.select(); }
    }, true);
  })();

  setInterval(render, 250);
  render();
})();
